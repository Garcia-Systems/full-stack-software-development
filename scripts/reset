#!/bin/sh
set -eu
docker compose down -v
docker compose up --build -d
printf 'Waiting for clean migrations and deterministic seed data'
i=0
until curl -fsS "http://localhost:${APP_PORT:-8080}/api/tickets" >/dev/null 2>&1; do i=$((i+1)); [ "$i" -lt 90 ] || { docker compose logs web db; exit 1; }; printf .; sleep 1; done
curl -fsS -X PUT -H 'Content-Type: application/json' -d '{"mode":"success"}' "http://localhost:${DEPENDENCY_PORT:-8090}/mode" >/dev/null
printf '\nReset complete: deterministic data, cache/queue state, and successful dependency mode restored.\n'
