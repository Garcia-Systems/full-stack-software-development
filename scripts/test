#!/bin/sh
set -eu
find app -path 'app/vendor' -prune -o -name '*.php' -print -exec php -l {} \; | tee /tmp/relaydesk-php-lint
./scripts/check-docs
if [ -x app/vendor/bin/phpunit ]; then (cd app && php artisan test); else echo 'WARNING: app/vendor is absent; host PHPUnit skipped (Docker image installs it).' >&2; fi
if command -v docker >/dev/null 2>&1 && docker compose version >/dev/null 2>&1; then
  docker compose down -v
  docker compose up --build -d
  trap 'docker compose down -v' EXIT
  i=0; until curl -fsS "http://localhost:${APP_PORT:-8080}/api/tickets" >/dev/null 2>&1; do i=$((i+1)); [ "$i" -lt 90 ] || { docker compose logs web db; exit 1; }; sleep 1; done
  docker compose exec web php artisan migrate:status
  docker compose exec web php artisan test
  ./scripts/smoke
else echo 'WARNING: Docker unavailable; skipped clean MySQL migration, PHPUnit image, and live smoke checks.' >&2; fi
