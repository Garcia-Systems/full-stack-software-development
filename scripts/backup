#!/bin/sh
set -eu
[ -f .env.production ] || { echo '.env.production is required' >&2; exit 2; }
set -a; . ./.env.production; set +a
mkdir -p backups
file="backups/relaydesk-${APP_VERSION}-$(date -u +%Y%m%dT%H%M%SZ).sql"
docker compose --env-file .env.production -f compose.production.yaml exec -T db \
  mysqldump -u"$DB_USERNAME" -p"$DB_PASSWORD" --single-transaction "$DB_DATABASE" > "$file"
test -s "$file"
echo "$file"
