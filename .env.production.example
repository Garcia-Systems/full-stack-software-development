# Copy to .env.production for the local production-like environment.
# Replace every CHANGE_ME value; never commit the resulting file.
APP_NAME=RelayDesk
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost:8080
APP_PORT=8080
APP_VERSION=local-production
APP_KEY=CHANGE_ME_generate_with_php_artisan_key_generate_show
DB_DATABASE=relaydesk
DB_USERNAME=relaydesk
DB_PASSWORD=CHANGE_ME_database_password
DB_ROOT_PASSWORD=CHANGE_ME_root_password
LOG_CHANNEL=stderr
LOG_LEVEL=info
CACHE_STORE=database
QUEUE_CONNECTION=database
DEPENDENCY_URL=http://dependency:8090
DEPENDENCY_CONNECT_TIMEOUT=0.3
DEPENDENCY_TIMEOUT=1.0
SESSION_SECURE_COOKIE=false
LAB_FAULTS=false
